# Database & Redis
DATABASE_URL="postgresql://klipforge:klipforge_dev_password@localhost:5432/klipforge?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-change-in-production"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="klipforge_minio"
S3_SECRET_KEY="klipforge_minio_secret"
S3_BUCKET="klipforge-media"
CDN_BASE_URL="http://localhost:9000/klipforge-media"

# Stripe
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# App URLs
PORT=4000
WEB_ORIGIN="http://localhost:5173"
AGENT_GEO_BLOCKED="false"

# Self-hosted unlimited access (every workspace on Business with unlimited credits).
# Set to "false" to use normal plans and credits.
UNLIMITED_ACCESS="true"
