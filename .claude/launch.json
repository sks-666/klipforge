    {
      "name": "klipforge-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace=apps/web", "exec", "--", "vite", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
