{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "klipforge-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:api"],
      "port": 4000
    },
    {
      "name": "klipforge-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:web"],
      "port": 5173
